import "./style.css";
import { LiveView, session } from "@elements/app";
import { WatchRow } from "#app/shared/lot";

function isWatching(watches: LiveView<WatchRow> | null, lotId: string): boolean {
  return watches?.some((w) => w.lotId === lotId) ?? false;
}

function onToggle(watches: LiveView<WatchRow> | null, lotId: string) {
  if (!watches) {
    return;
  }

  let row = watches.find((w) => w.lotId === lotId);

  if (row) {
    watches.delete(row);
  } else {
    watches.insert({ lotId, userId: session.getOrThrow("userId") });
  }
}

/** A star that adds a lot to the bidder's watchlist, or a sign-in link. */
<WatchToggle (watches: LiveView<WatchRow> | null, lotId: string, size: string = "is-sm")>
  <button e:if={watches}
          type="button"
          class={["watch-toggle", "is-ghost", size, isWatching(watches, lotId) && "is-watching"]}
          aria-pressed={isWatching(watches, lotId)}
          onclick={() => onToggle(watches, lotId)}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <path d="M12 3.5l2.6 5.3 5.9.9-4.25 4.1 1 5.8L12 16.9l-5.25 2.7 1-5.8L3.5 9.7l5.9-.9z"/>
    </svg>
    {isWatching(watches, lotId) ? "Watching" : "Watch"}
  </button>
  <a e:else class={["button", "watch-toggle", "is-ghost", size]} href="/signin">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <path d="M12 3.5l2.6 5.3 5.9.9-4.25 4.1 1 5.8L12 16.9l-5.25 2.7 1-5.8L3.5 9.7l5.9-.9z"/>
    </svg>
    Watch
  </a>
</WatchToggle>
