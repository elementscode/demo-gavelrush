import "./style.css";
import { LiveView, session } from "@elements/app";
import { WatchRow } from "#app/shared/lot";
import { Toggle } from "@elements/ui/toggle";
import { Button } from "@elements/ui/button";
import { Icon } from "@elements/ui/icon";

function isWatching(watches: LiveView<WatchRow> | null, lotId: string): boolean {
  return watches?.some((w) => w.lotId === lotId) ?? false;
}

function onToggle(watches: LiveView<WatchRow> | null, lotId: string) {
  if (!watches) {
    return;
  }

  let row = watches.find((w) => w.lotId === lotId);

  if (row) {
    watches.delete(row);
  } else {
    watches.insert({ lotId, userId: session.getOrThrow("userId") });
  }
}

/** A star that adds a lot to the bidder's watchlist, or a sign-in link. */
<WatchToggle (watches: LiveView<WatchRow> | null, lotId: string, block: boolean = false)>
  <Toggle e:if={watches}
          variant="outline"
          size={block ? "md" : "sm"}
          class={["watch-toggle", block && "is-block"].filter(Boolean).join(" ")}
          pressed={isWatching(watches, lotId)}
          onPressedChange={(_, details) => { details.cancel(); onToggle(watches, lotId); }}>
    <Icon name="star" />
    {isWatching(watches, lotId) ? "Watching" : "Watch"}
  </Toggle>
  <Button e:else variant="outline" size={block ? "md" : "sm"} {block} class="watch-toggle" href="/signin">
    <Icon name="star" />
    Watch
  </Button>
</WatchToggle>
