import "./style.css";

/**
 * Sent to the previous high bidder when someone bids over them on a lot they
 * watch.
 *
 * @email
 */
<html (name: string, lotId: string, lotNumber: number, title: string, amount: string, minimum: string, closes: string)>
  <body class="email outbid">
    <div class="email-wrap">
      <p class="brand">gavelrush</p>
      <h1>You've been outbid on lot {lotNumber}</h1>
      <p>Hi {name}, someone bid <strong>{amount}</strong> on <strong>{title}</strong>. The next bid is {minimum}, and bidding closes {closes}.</p>
      <p><a class="cta" href={`/lots/${lotId}`}>Bid again</a></p>

      <div class="email-footer">
        <p>You get this because you're watching this lot. Unwatch it on the lot page to stop these emails.</p>
      </div>
    </div>
  </body>
</html>
