import "./style.css";

/**
 * Sent to the winner when a lot closes, with the link that starts a card
 * payment.
 *
 * @email
 */
<html (name: string, lotId: string, lotNumber: number, title: string, amount: string)>
  <body class="email won">
    <div class="email-wrap">
      <p class="brand">gavelrush</p>
      <h1>You won lot {lotNumber}</h1>
      <p>Congratulations, {name}. Bidding on <strong>{title}</strong> has closed and your bid of <strong>{amount}</strong> is the winner.</p>
      <p>Every dollar goes to the charity. Pay by card to claim your lot:</p>
      <p><a class="cta" href={`/pay/${lotId}`}>Pay {amount} by card</a></p>

      <div class="email-footer">
        <p>Payments are processed securely by Stripe. Questions? Reply to this email.</p>
      </div>
    </div>
  </body>
</html>
