import "./style.css";
import { File, FieldErrors, ValidationError, redirect, sql, tx } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { SiteHeader } from "#app/shared/templates/site-header";
import { isUserAdminOrThrow } from "#app/shared/services/auth";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { DatePicker } from "@elements/ui/date-picker";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Textarea } from "@elements/ui/textarea";
import { TimePicker } from "@elements/ui/time-picker";

const ALLOWED = ["image/png", "image/jpeg", "image/gif", "image/webp"];
const MAX_PHOTO_BYTES = 5 * 1024 * 1024;

export interface NewLot {
  title: string;
  description: string;
  startingBid: number;
  increment: number;
  closesAt: Date;
  photos: File[];
}

interface LotForm {
  title: string;
  description: string;
  startingBid: string;
  increment: string;
  closesDate: string;
  closesTime: string;
  photos: File[];
  errors: FieldErrors<NewLot>;
  saving: boolean;
}

/** @rpc */
export function createLot(lot: NewLot): string {
  isUserAdminOrThrow();

  let errors: FieldErrors<NewLot> = {};

  if (!lot.title.trim()) {
    errors.title = ["Give the lot a title."];
  }

  if (!Number.isInteger(lot.startingBid) || lot.startingBid < 1) {
    errors.startingBid = ["Enter a whole-dollar amount of at least $1."];
  }

  if (!Number.isInteger(lot.increment) || lot.increment < 1) {
    errors.increment = ["Enter a whole-dollar amount of at least $1."];
  }

  if (!(lot.closesAt instanceof Date) || isNaN(+lot.closesAt) || +lot.closesAt < Date.now() + 60_000) {
    errors.closesAt = ["Pick a close time in the future."];
  }

  if (lot.photos.length === 0) {
    errors.photos = ["Add at least one photo."];
  } else if (lot.photos.some((f) => !ALLOWED.includes(f.contentType))) {
    errors.photos = ["Photos must be PNG, JPEG, GIF or WebP images."];
  } else if (lot.photos.some((f) => f.size > MAX_PHOTO_BYTES)) {
    errors.photos = ["Each photo must be under 5 MB."];
  }

  if (Object.keys(errors).length > 0) {
    throw new ValidationError(errors);
  }

  return tx(() => {
    let row = sql<{ id: string }>(`
      insert into lots (title, description, startingBid, increment, closesAt)
           values (${lot.title.trim()}, ${lot.description.trim()}, ${lot.startingBid}, ${lot.increment}, ${lot.closesAt})
      returning id
    `).firstOrThrow();

    lot.photos.forEach((f, i) => {
      sql(`
        insert into lotPhotos (lotId, position, name, contentType, data)
             values (${row.id}, ${i}, ${f.name}, ${f.contentType}, ${f.data})
      `);
    });

    return row.id;
  });
}

function toLocalInput(date: Date): string {
  let local = new Date(+date - date.getTimezoneOffset() * 60_000);

  return local.toISOString().slice(0, 16);
}

/** The date and the time of the close, in local time, as the pickers take them. */
function closeParts(date: Date): { closesDate: string; closesTime: string } {
  let [closesDate, closesTime] = toLocalInput(date).split("T");

  return { closesDate, closesTime };
}

function wholeDollars(value: string): number {
  return Number(value.replace(/[$,\s]/g, ""));
}

function onSubmit(form: LotForm) {
  form.errors = {};
  form.saving = true;

  try {
    let id = createLot({
      title: form.title,
      description: form.description,
      startingBid: wholeDollars(form.startingBid),
      increment: wholeDollars(form.increment),
      closesAt: new Date(`${form.closesDate}T${form.closesTime}`),
      photos: form.photos,
    });

    redirect(`/lots/${id}`);
  } catch (err: any) {
    form.errors = (err instanceof ValidationError && err.errors ? err.errors : { title: [err.message] }) as FieldErrors<NewLot>;
    form.saving = false;
  }
}

function previewUrl(file: File): string {
  return URL.createObjectURL(new Blob([file.data as BlobPart], { type: file.contentType }));
}

<html lang="en" class="page-admin-new-lot" (
  serverNow: Date,
  private form: LotForm = {
    title: "",
    description: "",
    startingBid: "",
    increment: "",
    ...closeParts(new Date(+serverNow + 3 * 86400_000)),
    photos: [],
    errors: {},
    saving: false,
  },
)>
  <head>
    <title>New lot · gavelrush</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="app">
      <SiteHeader current="new-lot" />

      <main class="page-shell is-form new-lot-page stack is-xl">
        <div class="stack is-xs">
          <p class="eyebrow">Admin</p>
          <h1>New lot</h1>
          <p class="lede">It goes live the moment you save it.</p>
        </div>

        <form onsubmit={() => onSubmit(form)}>
          <Card>
            <CardContent class="stack is-lg">
              <Field label="Title" error={form.errors.title?.[0] ?? ""}>
                <Input name="title" value={form.title} placeholder="Weekend at a mountain lodge" required attrs={{ id: "title" }} />
              </Field>

              <Field label="Description">
                <Textarea name="description" rows={5} value={form.description} placeholder="What the winner gets, who donated it, and any conditions." attrs={{ id: "description" }} />
              </Field>

              <Field label="Photos" description="The first photo is the cover. Up to 5 MB each." error={form.errors.photos?.[0] ?? ""}>
                <Input type="file" name="photos" multiple files={form.photos} attrs={{ id: "photos", accept: "image/png,image/jpeg,image/gif,image/webp" }} />
              </Field>
              <div e:if={form.photos.length > 0} class="photo-previews">
                <img e:for={f of form.photos.map((f) => ({ id: f.name + f.size, f }))} src={previewUrl(f.f)} alt={f.f.name} width="96" height="80">
              </div>

              <div class="new-lot-pair">
                <Field label="Starting bid ($)" error={form.errors.startingBid?.[0] ?? ""}>
                  <Input name="startingBid" value={form.startingBid} placeholder="250" required attrs={{ id: "startingBid", inputmode: "numeric" }} />
                </Field>
                <Field label="Bid increment ($)" error={form.errors.increment?.[0] ?? ""}>
                  <Input name="increment" value={form.increment} placeholder="25" required attrs={{ id: "increment", inputmode: "numeric" }} />
                </Field>
              </div>

              <Field label="Closes at" description="In your local time. A bid in the last two minutes adds two more." error={form.errors.closesAt?.[0] ?? ""}>
                <div class="new-lot-pair is-close">
                  <DatePicker value={form.closesDate} name="closesDate" required block attrs={{ id: "closesAt" }} />
                  <TimePicker value={form.closesTime} name="closesTime" label="Close time" required block />
                </div>
              </Field>
            </CardContent>

            <CardFooter>
              <Button variant="ghost" href="/admin">Cancel</Button>
              <Button type="submit" variant="primary" loading={form.saving}>Create lot</Button>
            </CardFooter>
          </Card>
        </form>
      </main>
    </div>
  </body>
</html>
