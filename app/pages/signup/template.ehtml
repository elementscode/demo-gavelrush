import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { SiteHeader } from "#app/shared/templates/site-header";
import { AuthShell } from "#app/shared/templates/auth-shell";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SignupForm, next: string) {
  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect(next);
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  next: string,
  private form: SignupForm = { name: "", email: "", password: "", error: "" },
)>
  <head>
    <title>Create an account · gavelrush</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="app">
      <SiteHeader />
      <AuthShell>
        <form class="auth-form stack is-lg" onsubmit={() => onSubmit(form, next)}>
          <div class="stack is-xs">
            <h1>Create an account</h1>
            <p class="auth-sub">It takes a minute, and then you can bid on any lot.</p>
          </div>

          <p e:if={form.error} class="callout is-danger" role="alert">{form.error}</p>

          <div class="field">
            <label for="name">Full name</label>
            <input id="name" name="name" value={form.name} autocomplete="name" placeholder="Ada Lovelace" required>
            <p class="hint">Other bidders see your first name and last initial.</p>
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" value={form.email}
                   autocomplete="email" autocapitalize="none" spellcheck={false}
                   placeholder="you@example.com" required>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" value={form.password}
                   autocomplete="new-password" minlength={MIN_PASSWORD} required>
            <p class="hint">At least {MIN_PASSWORD} characters.</p>
          </div>

          <button type="submit" class="is-primary is-block">Create account</button>

          <p>Already have an account? <a href={next === "/" ? "/signin" : `/signin?next=${encodeURIComponent(next)}`}>Sign in</a></p>
        </form>
      </AuthShell>
    </div>
  </body>
</html>
