import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { SiteHeader } from "#app/shared/templates/site-header";
import { AuthShell } from "#app/shared/templates/auth-shell";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SignupForm, next: string) {
  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect(next);
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  next: string,
  private form: SignupForm = { name: "", email: "", password: "", error: "" },
)>
  <head>
    <title>Create an account · gavelrush</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="app">
      <SiteHeader />
      <AuthShell>
        <form class="auth-form stack is-lg" onsubmit={() => onSubmit(form, next)}>
          <div class="stack is-xs">
            <h1>Create an account</h1>
            <p class="auth-sub">It takes a minute, and then you can bid on any lot.</p>
          </div>

          <Alert e:if={form.error} variant="danger" description={form.error} />

          <Field label="Full name" description="Other bidders see your first name and last initial.">
            <Input name="name" value={form.name} placeholder="Ada Lovelace" required attrs={{ id: "name", autocomplete: "name" }} />
          </Field>

          <Field label="Email">
            <Input type="email" name="email" value={form.email} placeholder="you@example.com" required
                   attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
          </Field>

          <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`}>
            <Input type="password" name="password" value={form.password} required
                   attrs={{ id: "password", autocomplete: "new-password", minlength: MIN_PASSWORD }} />
          </Field>

          <Button type="submit" variant="primary" block>Create account</Button>

          <p>Already have an account? <a href={next === "/" ? "/signin" : `/signin?next=${encodeURIComponent(next)}`}>Sign in</a></p>
        </form>
      </AuthShell>
    </div>
  </body>
</html>
