import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { SiteHeader } from "#app/shared/templates/site-header";
import { AuthShell } from "#app/shared/templates/auth-shell";
import { signin } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

export interface DemoLogin {
  email: string;
  name: string;
  role: string;
  password: string;
}

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SigninForm, next: string) {
  try {
    signin(form.email, form.password);
    form.error = "";
    redirect(next);
  } catch (err: any) {
    form.error = err.message;
  }
}

function onPick(form: SigninForm, login: DemoLogin) {
  form.email = login.email;
  form.password = login.password;
  form.error = "";
}

<html lang="en" class="page-signin" (
  next: string,
  demoLogins: DemoLogin[],
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <head>
    <title>Sign in · gavelrush</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="app">
      <SiteHeader />
      <AuthShell>
        <div class="auth-form stack is-xl">
          <form class="stack is-lg" onsubmit={() => onSubmit(form, next)}>
            <div class="stack is-xs">
              <h1>Sign in</h1>
              <p class="auth-sub">Welcome back. The auction is live.</p>
            </div>

            <Alert e:if={form.error} variant="danger" description={form.error} />

            <Field label="Email">
              <Input type="email" name="email" value={form.email} placeholder="you@example.com" required
                     attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
            </Field>

            <Field label="Password">
              <Input type="password" name="password" value={form.password} required
                     attrs={{ id: "password", autocomplete: "current-password" }} />
            </Field>

            <Button type="submit" variant="primary" block>Sign in</Button>

            <p>New to gavelrush? <a href={next === "/" ? "/signup" : `/signup?next=${encodeURIComponent(next)}`}>Create an account</a></p>
          </form>

          <Card e:if={demoLogins.length > 0} title="Demo accounts" level={2} size="sm">
            <CardContent class="stack is-sm">
              <p class="text-sm">Pick one to fill the form. Bidders use <code>bidder-pass</code>, the admin uses <code>admin-pass</code>.</p>
              <div class="demo-logins stack">
                <button e:for={login of demoLogins.map((l) => ({ ...l, id: l.email }))}
                        type="button"
                        class="button is-ghost is-block demo-login"
                        onclick={() => onPick(form, login)}>
                  <span class="row is-sm demo-login-name">
                    <span>{login.name}</span>
                    <Badge e:if={login.role === "admin"} variant="accent">Admin</Badge>
                  </span>
                  <span class="demo-login-email">{login.email}</span>
                </button>
              </div>
            </CardContent>
          </Card>
        </div>
      </AuthShell>
    </div>
  </body>
</html>
